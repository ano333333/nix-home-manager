  "hardening": {
    "date": "2026-11-27",
    "manifest": "downloads.json",
    "changes": [
      "Pinned all direct downloads by SHA256; cache mismatches and unknown URLs are fatal. Hashes captured from HTTPS downloads, not proof of publisher authenticity.",
      "Winetricks pinned at f3890f6; SHA256 mandatory for downloads and mismatch always fatal. DXVK 2.7.1, VKD3D 3.1 pinned; VC runtime uses resolved Microsoft URLs. Corefonts/.NET hashes remain in the pinned Winetricks source.",
      "dcomp built with static compiler runtimes from reviewed source. Prebuilt media, pthread and thumbnail executables omitted from runtime package.",
      "No upstream asset fallback, icon downloads, host package installation, esync host writes, prewarm service or deletion of other prefixes desktop files.",
      "Original upstream source retained for review. No upstream uninstall command is exposed."
    ],
    "remaining": [
      "WebView2 --no-sandbox retained for compatibility; FHS is not a home-directory security boundary.",
      "Wine and Microsoft components are downloaded binaries, not reproduced from source.",
      "Full install/login/drawing untested. Existing installed files in a previously used CSPenguin prefix are not re-attested or automatically removed."
    ]
  }
}
